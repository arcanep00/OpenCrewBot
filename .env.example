# Copy to .env and fill in. Every key is optional: without a model key
# the app runs in mock mode so you can click through the whole UI.

# --- Models ---

# Nebius Token Factory — open-source models (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# OpenAI — GPT-4o, o3-mini, o4-mini (https://platform.openai.com/api-keys)
# Also works with LM Studio local models:
#   OPENAI_API_KEY=lm-studio
#   OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=

# Anthropic — Claude Sonnet, Haiku, Opus (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# --- Tools ---

# Web search, page extract and site crawl (https://app.tavily.com)
TAVILY_API_KEY=

# Cloud browser for bots with the Browser tool (https://www.browserbase.com)
BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_SESSION_MINUTES=15

# --- Integrations ---

# GitHub, Gmail, Slack, Notion and 1000+ more via Composio (https://platform.composio.dev)
COMPOSIO_API_KEY=

# --- Routing ---

# Jev picks who answers in Auto rooms (https://typesafe.ai)
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# --- Storage ---

# Where bots, chats and MEMORY.md files live (default: ./data)
# OPENCREWBOT_DATA_DIR=./data
